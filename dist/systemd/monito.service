[Unit]
Description=Monito Background Network Accounting Collector Daemon
Documentation=https://github.com/BraveRam/monito
After=network.target local-fs.target
Wants=network.target

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=60
ExecStart=/usr/local/bin/monitod --db=/var/lib/monito/monito.db --socket=/run/monito/monito.sock --cgroup=/sys/fs/cgroup
Restart=always
RestartSec=3s

# Runtime and storage directories
RuntimeDirectory=monito
RuntimeDirectoryMode=0755
StateDirectory=monito
StateDirectoryMode=0755

# eBPF accounting, process metadata, and recovery of existing sockets at application IO.
AmbientCapabilities=CAP_BPF CAP_NET_ADMIN CAP_PERFMON
CapabilityBoundingSet=CAP_BPF CAP_NET_ADMIN CAP_PERFMON

# Security Hardening
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ProtectControlGroups=false
# ProtectKernelTunables=yes also hides kallsyms, needed by the eBPF loader.
# Keep its tunable paths read-only explicitly; only the symbol table stays readable.
ReadOnlyPaths=/proc/sys /sys /proc/sysrq-trigger -/proc/latency_stats -/proc/acpi -/proc/timer_stats -/proc/fs -/proc/irq -/proc/mtrr -/proc/scsi /proc/kallsyms
InaccessiblePaths=-/proc/kcore
ProtectKernelModules=true
MemoryDenyWriteExecute=false
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true

# Resource Limits
LimitMEMLOCK=infinity
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
